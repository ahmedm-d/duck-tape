# Configure server process environment; never expose keys to Vite/browser.
STEWARD_MODEL_PROVIDER=ollama
STEWARD_MODEL_ENDPOINT=http://127.0.0.1:11434
STEWARD_MODEL=
STEWARD_SMALL_MODEL=
STEWARD_EMBEDDING_MODEL=
STEWARD_EMBEDDING_ENDPOINT=
# A separate embedding endpoint uses the same protocol; its optional key is independent.
STEWARD_EMBEDDING_KEY=
# Reasoning models (e.g. Adaption qwen3.5-397b) need room to answer: 4096 truncated some requests in
# docs/evidence/model-comparison. Prompt plus reserved answer must fit the context limit; with Ollama also set
# OLLAMA_CONTEXT_LENGTH to at least this context limit, or Ollama silently cuts long prompts.
STEWARD_CONTEXT_LIMIT=32000
STEWARD_MAX_OUTPUT_TOKENS=8192
# Local CPU inference can take minutes per request.
STEWARD_MODEL_TIMEOUT=600
# STEWARD_MODEL_KEY=optional-server-only-key
# STEWARD_DATA_DIR=C:/path/to/local/duck-tape-data
# STEWARD_SANDBOX_PYTHON_IMAGE=steward-python:1
# STEWARD_SANDBOX_NODE_IMAGE=steward-node:1

# Hosted alternatives: replace the active provider/endpoint/model above.
# STEWARD_MODEL_PROVIDER=adaption
# STEWARD_MODEL_ENDPOINT=https://api.prod.adaptionlabs.ai/api/v1
# STEWARD_MODEL=<model from your account catalog>
# ADAPTION_API_KEY=
# Adaption: prompted JSON + local validation, not constrained generation.
# STEWARD_MODEL_PROVIDER=huggingface
# STEWARD_MODEL_ENDPOINT=https://router.huggingface.co/v1
# STEWARD_MODEL=<Hugging-Face-model-id:provider>
# HF_TOKEN=
# STEWARD_MODEL_PROVIDER=anthropic
# STEWARD_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# STEWARD_ANTHROPIC_EFFORT=high
# Hosted kinds require a separate OpenAI-compatible embedding endpoint/key.

# Duck Tape internal memory/evaluation: explicit operator commands, disabled until configured.
# These credentials and dependencies never belong in imported repositories.
# Atlas is a compulsory part of repository knowledge: run.py refuses to start unless Atlas is enabled, configured and reachable.
# STEWARD_ATLAS_ENABLED=1, STEWARD_ATLAS_URI and STEWARD_ATLAS_DIMENSIONS are therefore required for production.
# STEWARD_ATLAS_REQUIRED=0 is only an escape hatch for tests, CI and the deterministic acceptance gates; never use it in production.
STEWARD_ATLAS_REQUIRED=1
STEWARD_ATLAS_ENABLED=1
# Required: STEWARD_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
STEWARD_ATLAS_DATABASE=ducktape
STEWARD_ATLAS_COLLECTION=evidence_vectors
STEWARD_ATLAS_INDEX=evidence_vectors
# Match the actual embedding model and index; do not assume this dimension.
# Required: STEWARD_ATLAS_DIMENSIONS=768
# Optional Graphify knowledge-map CLI, installed separately: uv tool install graphifyy==0.9.108 --python 3.11
# STEWARD_GRAPHIFY_BIN=C:/Users/<you>/.local/bin/graphify.exe
# builtin (default) or graphify: also expand retrieval along Graphify EXTRACTED cross-file edges.
STEWARD_GRAPH_ENGINE=builtin
# Opt-in when STEWARD_ATLAS_REQUIRED=0 (required mode uses Atlas by default): add validated Atlas vector candidates to generic retrieval (sends query embeddings to Atlas).
STEWARD_ATLAS_RETRIEVAL=0
# Opt-in when STEWARD_ATLAS_REQUIRED=0 (part of the projection in required mode): mirror repo graph (paths, labels, declaration lines) and approved knowledge text to the private Atlas database. Needs STEWARD_ATLAS_ENABLED=1.
STEWARD_ATLAS_GRAPH_MIRROR=0
STEWARD_DATABRICKS_ENABLED=0
# STEWARD_DATABRICKS_HOST=https://<workspace-host>
# STEWARD_DATABRICKS_TOKEN=
# STEWARD_DATABRICKS_WAREHOUSE_ID=
STEWARD_DATABRICKS_TABLE=workspace.default.ducktape_runs

# Supabase accounts (optional sign-up/sign-in): set both values to offer accounts; the workspace stays open
# without one. Use the project URL (https://<ref>.supabase.co) and the PUBLISHABLE key (sb_publishable_...),
# which the browser receives from /api/auth/config. Never put the secret key (sb_secret_...) here.
# STEWARD_SUPABASE_URL=https://<ref>.supabase.co
# STEWARD_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 1 makes sign-in compulsory for every API request and run.py refuses to start without working Supabase.
STEWARD_AUTH_REQUIRED=0

# Separate public catalogue, prepared by C; see docs/BACKEND_DEMO_HANDOFF.md.
STEWARD_GLOBAL_ATLAS_ENABLED=0
# STEWARD_GLOBAL_ATLAS_URI=mongodb+srv://<public-reader>:<password>@<cluster>/
STEWARD_GLOBAL_DATABRICKS_ENABLED=0
# STEWARD_GLOBAL_CATALOGUE_PATH=data/global-public.sqlite3
# Optional served specialist IDs on the configured provider endpoint (not training run IDs).
# STEWARD_IMPLEMENTATION_MODEL=
# STEWARD_REPAIR_MODEL=
# STEWARD_REGRESSION_MODEL=
# STEWARD_ACCEPTANCE_MODEL=

# Route specialist roles to Claude without LoRA deployment; set 0 for controller-only mode.
STEWARD_SPECIALIST_MODE=1
