# Configure server process environment; never expose keys to Vite/browser.
STEWARD_MODEL_PROVIDER=ollama
STEWARD_MODEL_ENDPOINT=http://127.0.0.1:11434
STEWARD_MODEL=
STEWARD_SMALL_MODEL=
STEWARD_EMBEDDING_MODEL=
STEWARD_EMBEDDING_ENDPOINT=
# A separate embedding endpoint uses the same protocol; its optional key is independent.
STEWARD_EMBEDDING_KEY=
STEWARD_CONTEXT_LIMIT=16000
STEWARD_MAX_OUTPUT_TOKENS=4096
STEWARD_MODEL_TIMEOUT=180
# STEWARD_MODEL_KEY=optional-server-only-key
# STEWARD_DATA_DIR=C:/path/to/local/steward-data
# STEWARD_SANDBOX_PYTHON_IMAGE=steward-python:1
# STEWARD_SANDBOX_NODE_IMAGE=steward-node:1

# Hosted alternatives: replace the active provider/endpoint/model above.
# STEWARD_MODEL_PROVIDER=adaption
# STEWARD_MODEL_ENDPOINT=https://api.prod.adaptionlabs.ai/api/v1
# STEWARD_MODEL=<model from your account catalog>
# ADAPTION_API_KEY=
# Adaption: prompted JSON + local validation, not constrained generation.
# STEWARD_MODEL_PROVIDER=huggingface
# STEWARD_MODEL_ENDPOINT=https://router.huggingface.co/v1
# STEWARD_MODEL=<Hugging-Face-model-id:provider>
# HF_TOKEN=
# Hosted kinds require a separate OpenAI-compatible embedding endpoint/key.

# Duck Tape internal memory/evaluation: explicit operator commands, disabled until configured.
# These credentials and dependencies never belong in imported repositories.
STEWARD_ATLAS_ENABLED=0
# STEWARD_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
STEWARD_ATLAS_DATABASE=ducktape
STEWARD_ATLAS_COLLECTION=evidence_vectors
STEWARD_ATLAS_INDEX=evidence_vectors
# Match the actual embedding model and index; do not assume this dimension.
# STEWARD_ATLAS_DIMENSIONS=768
STEWARD_DATABRICKS_ENABLED=0
# STEWARD_DATABRICKS_HOST=https://<workspace-host>
# STEWARD_DATABRICKS_TOKEN=
# STEWARD_DATABRICKS_WAREHOUSE_ID=
STEWARD_DATABRICKS_TABLE=workspace.default.ducktape_runs
