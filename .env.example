# Configure server process environment; never expose keys to Vite/browser.
STEWARD_MODEL_PROVIDER=ollama
STEWARD_MODEL_ENDPOINT=http://127.0.0.1:11434
STEWARD_MODEL=
STEWARD_SMALL_MODEL=
STEWARD_EMBEDDING_MODEL=
STEWARD_EMBEDDING_ENDPOINT=
# A separate embedding endpoint uses the same protocol; its optional key is independent.
STEWARD_EMBEDDING_KEY=
STEWARD_CONTEXT_LIMIT=16000
STEWARD_MAX_OUTPUT_TOKENS=4096
STEWARD_MODEL_TIMEOUT=180
# STEWARD_MODEL_KEY=optional-server-only-key
# STEWARD_DATA_DIR=C:/path/to/local/steward-data
# STEWARD_SANDBOX_PYTHON_IMAGE=steward-python:1
# STEWARD_SANDBOX_NODE_IMAGE=steward-node:1
