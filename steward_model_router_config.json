    "security_reviewer_dpo": {
      "pool": "qwen",
      "slug": "security_reviewer_dpo",
      "model_env": "STEWARD_SPECIALIST_SECURITY_REVIEWER_DPO_MODEL"
    },
    "db_migration": {
      "pool": "qwen",
      "slug": "db_migration",
      "model_env": "STEWARD_SPECIALIST_DB_MIGRATION_MODEL"
    },
    "iac": {
      "pool": "qwen",
      "slug": "iac",
      "model_env": "STEWARD_SPECIALIST_IAC_MODEL"
    },
    "frontend_ui": {
      "pool": "qwen",
      "slug": "frontend_ui",
      "model_env": "STEWARD_SPECIALIST_FRONTEND_UI_MODEL"
    }
